# $BITE activity bot — copy to bots/.env (preferred) or repo-root .env
# Never commit real tokens. Do not paste secrets into chat.

# Telegram (required for --test / live posts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Chain / token (defaults match live launch)
BITE_CONTRACT=0x0d6e3D5D99a92499f584Ac821a64b237e5cEf3c9
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
SITE_URL=https://www.bite.party

# 1 = Act I (burns detected but not posted; holders/buys may post)
# 2+ = burn posts + milestones enabled
PHASE=1

# Optional Twitter/X
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=

# Optional tuning
# POST_ACTIVITY=0          # 1 to post notable Transfer activity (default off in Act I)
# MIN_SWAP_AMOUNT=50
# MIN_BURN_AMOUNT=100
# BITE_BOT_STATE_FILE=
# POINTS_PER_BITE_GAINED=1
# HOLD_BITE_PER_POINT_PER_HOUR=100
# LEADERBOARD_TOP_N=10
# Sanitized Act I board for the site (wallets + points + trades only)
# BITE_LEADERBOARD_PUBLIC_FILE=public/data/act1-leaderboard.json
# First Transfer / pons TokenLaunched block for live $BITE (default 63818043)
# TRADE_SCAN_FROM_BLOCK=63818043
# LOG_CHUNK_SIZE=10000
# Creator wallets shown on the board with Dev badge (ineligible to win)
# DEV_WALLETS=0xEB95ff72EAb9e8D8fdb545FE15587AcCF410b42E
# INELIGIBLE_WALLETS=
