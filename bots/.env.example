# $BITE activity bot — copy to bots/.env (preferred) or repo-root .env
# Never commit real tokens. Do not paste secrets into chat.

# Telegram (required for --test / live posts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Chain / token — set after your launch (no production defaults)
BITE_CONTRACT=
AAPL_TOKEN=0xaF3D76f1834A1d425780943C99Ea8A608f8a93f9
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
SITE_URL=https://www.bite.party
# Primary buy CTA — opens native swap modal on the site
BUY_URL=https://www.bite.party/#swap
# Secondary fallback only (shown as "Pons (fallback)" on /buy)
PONS_BUY_URL=

# 1 = Act I (burns detected but not posted; holders/buys may post)
# 2+ = burn posts + milestones enabled
PHASE=1

# Optional Twitter/X
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=

# Optional tuning
# POST_ACTIVITY=0
# MIN_SWAP_USD=50
# MIN_BURN_USD=50
# MIN_SWAP_AMOUNT=500000
# MIN_BURN_AMOUNT=500000
# TG_POST_COOLDOWN=45
# CATCH_UP_BLOCK_THRESHOLD=100
# BITE_BOT_STATE_FILE=
# POINTS_PER_BITE_GAINED=0.01
# HOLD_BITE_PER_POINT_PER_HOUR=10000
# LEADERBOARD_TOP_N=10
# SCORE_WALLETS_PER_POLL=120
# BITE_LEADERBOARD_PUBLIC_FILE=public/data/act1-leaderboard.json
# TRADE_SCAN_FROM_BLOCK=
# LOG_CHUNK_SIZE=10000
# Creator wallets shown on the board with Dev badge (comma-separated EOAs)
# DEV_WALLETS=
# INELIGIBLE_WALLETS=

# Blockscout Pro API — https://api.blockscout.com/{CHAIN_ID}/api/v2/...
# Never commit the key. Falls back to RPC balanceOf when unset.
# BLOCKSCOUT_API_KEY=
# BLOCKSCOUT_API_BASE=https://api.blockscout.com/4663/api/v2
# RPC_HOLDER_SYNC_INTERVAL_SEC=180
# DEXSCREENER_PAIR_ID=

# Railway / remote hosting — HTTP server for leaderboard sync
# PORT=
# LEADERBOARD_HTTP_PORT=8080

# Pons V2 fee escrow + kitchen / wager (display / scoring)
# PONS_FEE_ESCROW=
# KITCHEN_CONTRACT=
# META_WAGER_CONTRACT=
# WAGER_SCORE_MULT=0.001

# Private admin DMs — same TELEGRAM_BOT_TOKEN, NOT the public channel.
# TELEGRAM_ADMIN_CHAT_ID=
# ADMIN_REPORT_INTERVAL_SEC=21600
# ADMIN_REPORT_LOOKBACK_BLOCKS=25000
# Interactive: DM the bot /kitchen — admin-only native-swap KPI + kitchen
# One-shot CLI: python -m bots --admin-report
# How to get chat id: DM the bot, then GET .../bot$TELEGRAM_BOT_TOKEN/getUpdates → message.chat.id
# Public /stats stays the supply breakdown for everyone; /kitchen is ops-only.
#
# Native (in-app) swap KPI — fee skim Transfer→kitchen index + client confirms.
# HTTP (Railway): GET /swap-stats.json · POST /native-swap
# Site: GET|POST /api/swap-stats (forwards POST when BITE_LEADERBOARD_URL / BITE_SWAP_INGEST_URL set)
# Definition: SwapModal / Trading API integratorFees → kitchen — NOT all-chain DEX volume.

# ── ReferralEscrow attester (qualify after in-app buy + kitchen bite) ──
# Set your proxy after deploy. rewardPerReferral default = 1000 BITE. Never commit keys.
# REFERRAL_ESCROW=
# Prefer a dedicated attester key (must equal on-chain attester()):
# REFERRAL_ATTESTER_KEY=
# Or reuse kitchen deploy PRIVATE_KEY if that EOA is still the attester.
# PRIVATE_KEY=
# REFERRAL_AUTO_QUALIFY=1
# Minimum swap USD value for referral qualification ($25 default, 0 to disable)
# REFERRAL_MIN_SWAP_USD=25
# BITE-amount fallback when no Dexscreener price (500k default)
# REFERRAL_MIN_SWAP_BITE=500000
# Manual: python -m bots --qualify 0xReferee…
