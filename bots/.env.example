# $BITE activity bot — copy to bots/.env (preferred) or repo-root .env
# Never commit real tokens. Do not paste secrets into chat.

# Telegram (required for --test / live posts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Chain / token (defaults match live launch)
BITE_CONTRACT=0x0d6e3D5D99a92499f584Ac821a64b237e5cEf3c9
AAPL_TOKEN=0xaF3D76f1834A1d425780943C99Ea8A608f8a93f9
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
SITE_URL=https://www.bite.party
# Primary buy CTA — opens native swap modal on the site
BUY_URL=https://www.bite.party/#swap
# Secondary fallback only (shown as "Pons (fallback)" on /buy)
PONS_BUY_URL=https://www.ponsfamily.com/launchpad/0x0d6e3D5D99a92499f584Ac821a64b237e5cEf3c9

# 1 = Act I (burns detected but not posted; holders/buys may post)
# 2+ = burn posts + milestones enabled
PHASE=1

# Optional Twitter/X
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=

# Optional tuning
# POST_ACTIVITY=0          # 1 to post notable buy activity (always off unless explicit)
# MIN_SWAP_USD=50            # Minimum USD value for buy posts (uses Dexscreener priceUsd)
# MIN_BURN_USD=50            # Minimum USD value for burn posts (uses Dexscreener priceUsd)
# MIN_SWAP_AMOUNT=500000     # BITE-amount fallback when priceUsd unavailable (high to be safe)
# MIN_BURN_AMOUNT=500000     # BITE-amount fallback when priceUsd unavailable (high to be safe)
# TG_POST_COOLDOWN=45        # Min seconds between Telegram broadcast posts (rate limit)
# CATCH_UP_BLOCK_THRESHOLD=100  # Blocks behind before suppressing TG posts (catch-up mode)
# BITE_BOT_STATE_FILE=
# POINTS_PER_BITE_GAINED=0.01
# HOLD_BITE_PER_POINT_PER_HOUR=10000
# LEADERBOARD_TOP_N=10
# Max balanceOf reads per poll for unlinked wallets (linked+dev always scored)
# SCORE_WALLETS_PER_POLL=120
# Sanitized Act I board for the site (wallets + points + trades only)
# BITE_LEADERBOARD_PUBLIC_FILE=public/data/act1-leaderboard.json
# First Transfer / pons TokenLaunched block for live $BITE (default 63818043)
# TRADE_SCAN_FROM_BLOCK=63818043
# LOG_CHUNK_SIZE=10000
# Creator wallets shown on the board with Dev badge (ineligible to win)
# DEV_WALLETS=0xEB95ff72EAb9e8D8fdb545FE15587AcCF410b42E
# INELIGIBLE_WALLETS=

# Blockscout Pro API — https://api.blockscout.com/{CHAIN_ID}/api/v2/...
# Used for token holders + counters (and address txs). Never commit the key.
# When the key is missing/out of credits, the bot falls back to RPC balanceOf.
# BLOCKSCOUT_API_KEY=
# BLOCKSCOUT_API_BASE=https://api.blockscout.com/4663/api/v2
# RPC_HOLDER_SYNC_INTERVAL_SEC=180
# DEXSCREENER_PAIR_ID=0x76d38162a8ef7da08c92777299fbbfe02748eea05e7cd125131a537b3f08f15c

# Railway / remote hosting — HTTP server for leaderboard sync
# Railway auto-sets PORT; locally you can use LEADERBOARD_HTTP_PORT
# PORT=                    # Railway sets this automatically
# LEADERBOARD_HTTP_PORT=8080  # Manual override for local testing

# Pons V2 fee escrow (kitchen-attributed claimable AAPL, display-only)
# PONS_FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
# KITCHEN_CONTRACT=0x56fEb999D829761C787581413605bf88F5Cd81e0
# META_WAGER_CONTRACT=0x73bc28aaDaf3B1BCdeD9dE456149d54aebCdC878
# WAGER_SCORE_MULT=0.001   # pts per $BITE staked on entry (gross, incl. 10% fee)

# Private admin DMs (kitchen + swap/fee skim) — same TELEGRAM_BOT_TOKEN, NOT the public channel.
# TELEGRAM_ADMIN_CHAT_ID=     # your Telegram user id / private chat id (required for DMs + /kitchen)
# ADMIN_REPORT_INTERVAL_SEC=21600   # every 6h; set 0 to disable scheduled DMs
# ADMIN_REPORT_LOOKBACK_BLOCKS=25000  # first-run / forced fee-transfer lookback
# Interactive: DM the bot /kitchen (aliases: /report) — admin-only, replies in your DM
# One-shot CLI: python -m bots --admin-report
# How to get chat id: DM the bot, then GET .../bot$TELEGRAM_BOT_TOKEN/getUpdates → message.chat.id
# Public /stats stays the supply breakdown for everyone; /kitchen is ops-only.
