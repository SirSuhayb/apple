# AppleKitchen deploy — copy to contracts/.env (never commit secrets)
# forge script script/DeployKitchen.s.sol:DeployKitchen --rpc-url $RPC_URL --broadcast --private-key $PRIVATE_KEY

RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
PRIVATE_KEY=

# Your $BITE + AAPL on Robinhood (4663)
BITE_TOKEN=
AAPL_TOKEN=0xaF3D76f1834A1d425780943C99Ea8A608f8a93f9

# Farmer / creator wallet (excluded from eaters; ineligible on Act I board)
# Use your own EOA — never commit a private key for this address.
DEPLOYER=
OWNER=

# 50% of 1B total supply (adjust if reserved/LP floor should be subtracted)
CORE_TARGET=500000000000000000000000000

# Unix deadline — set AFTER watching early burn velocity if preferred.
# Example: now + 30 days. Override before broadcast.
# DEADLINE=

MIN_HOLD=1000000000000000000
MIN_CONSUMPTION=1

# V4KitchenRouter (digest buy-and-burn adapter). Deploy does NOT call setRouter.
# V4_KITCHEN_ROUTER=
# KITCHEN_CONTRACT=
# UNISWAP_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
# V4_HOOKS=
# V4_POOL_FEE=0
# V4_TICK_SPACING=200
# V4_POOL_ID=

# ReferralEscrow (UUPS) — ./scripts/deploy-referral-escrow.sh
# Script forces owner+attester = PRIVATE_KEY address (kitchen deploy EOA).
# REWARD_PER_REFERRAL=100000000000000000000
# REFERRAL_ESCROW_PROXY=
