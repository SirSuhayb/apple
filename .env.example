# Next public env — copy to .env.local and fill with YOUR values.
# Never commit .env.local or real secrets.

# Robinhood Chain
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# WalletConnect Cloud project ID (https://cloud.walletconnect.com).
# Required for the WalletConnect connector; if unset, that connector is skipped
# (injected + Coinbase still work). Set in Vercel for production.
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional Ethereum mainnet RPC for ENS reverse-resolution on the leaderboard.
# Defaults to a public mainnet fallback list (1rpc / publicnode / Cloudflare).
# ENS_RPC_URL=https://1rpc.io/eth
# MAINNET_RPC_URL=

# $BITE after pons launch. Leave blank for preview mode.
NEXT_PUBLIC_BITE_TOKEN=
NEXT_PUBLIC_BITE_CURVE=
NEXT_PUBLIC_BITE_POOL=
NEXT_PUBLIC_APPLE_KITCHEN=
NEXT_PUBLIC_DEPLOYER=
NEXT_PUBLIC_PONS_TOKEN_URL=
# NEXT_PUBLIC_PONS_FEE_ESCROW=
# NEXT_PUBLIC_META_WAGER=

# AAPL (Robinhood stock token) — chain default if unset
# NEXT_PUBLIC_AAPL_TOKEN=0xaF3D76f1834A1d425780943C99Ea8A608f8a93f9

# Race params (used before kitchen is live / as fallbacks)
NEXT_PUBLIC_DEADLINE_DAYS=30
NEXT_PUBLIC_CORE_TARGET_FRACTION=0.5

# ── Site narrative acts ──────────────────────────────────────────────
# Prologue = Pre-mint tease (no buy/trade CTAs → pons)
# Act I    = Finding the apple (preparing; burns locked; trading open)
# Act II   = First bite (kitchen live; early-eater 2×; meta wager locked)
# Act III  = To the core (auto when ≥5 eaters AND burn ≥10%, or force below)
#
# Token CA is set → Act I auto-resolves when SITE_ACT / PROLOGUE are unset.
# Force act for QA only (omit in production to auto-resolve):
#   NEXT_PUBLIC_SITE_ACT=0  → Prologue
#   NEXT_PUBLIC_SITE_ACT=1  → Act I
#   NEXT_PUBLIC_SITE_ACT=2  → Act II
#   NEXT_PUBLIC_SITE_ACT=3  → Act III
# Do NOT set NEXT_PUBLIC_SITE_ACT or NEXT_PUBLIC_PROLOGUE in production.
# NEXT_PUBLIC_SITE_ACT=1
#
# Optional Prologue toggles (SITE_ACT wins if set) — leave unset in production:
# NEXT_PUBLIC_PROLOGUE=true
# NEXT_PUBLIC_PROLOGUE=false

# Unix timestamp when Act II started — drives 72h early-eater 2× banner.
# NEXT_PUBLIC_ACT_II_STARTED_AT=

# Burn progress (0–1) at which meta wager unlocks (default 0.1 = 10%)
# NEXT_PUBLIC_META_WAGER_THRESHOLD=0.1

# ReferralEscrow UUPS proxy — fund this address, not the impl. Set after deploy.
NEXT_PUBLIC_REFERRAL_ESCROW=

# Day-one / launch preview
# true  → auto stop-motion; hide burn modal CTA (Act I feel)
# false → show burn modal when Act ≥ II
# Default: true when kitchen or token is missing; set explicitly for QA.
NEXT_PUBLIC_DAY_ONE=true
# NEXT_PUBLIC_DEMO_PLAYTHROUGH=true

# Trade / Buy CTAs — in-site Uniswap v4 swap is default (AAPL ↔ $BITE)
# native (default) = SwapModal quotes via /api/uniswap/* (server-only Trading API key)
# pons = deep-link to NEXT_PUBLIC_PONS_TOKEN_URL
# NEXT_PUBLIC_SWAP_PROVIDER=pons
# Server-only Uniswap Trading API key — never NEXT_PUBLIC_
# UNISWAP_API_KEY=
# Swap integrator fee: 50 bps (0.5%) to kitchen. Cap 500.
# Ops recipient is optional — set your own EOA if you split fees.
# SWAP_OPS_RECIPIENT=
# NEXT_PUBLIC_SWAP_OPS_RECIPIENT=
# NEXT_PUBLIC_SWAP_EMBED_ENABLED=true
# Optional URL overrides (uniswap provider only):
# NEXT_PUBLIC_SWAP_EMBED_URL=
# NEXT_PUBLIC_SWAP_OPEN_URL=

# Social / chart (optional)
# NEXT_PUBLIC_TWITTER_URL=
# NEXT_PUBLIC_TELEGRAM_URL=
# NEXT_PUBLIC_CHART_URL=

# ── Activity bot (Telegram) — prefer bots/.env ───────────────────────
# Never commit tokens.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# BITE_CONTRACT=
# RPC_URL=https://rpc.mainnet.chain.robinhood.com
# PHASE=1
# DEV_WALLETS=
