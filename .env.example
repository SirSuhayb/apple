# Next public env — fill after pons launch / mint morning

# Robinhood Chain
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Set these after you launch $BITE on pons vs AAPL
NEXT_PUBLIC_BITE_TOKEN=
NEXT_PUBLIC_BITE_CURVE=
NEXT_PUBLIC_BITE_POOL=
NEXT_PUBLIC_APPLE_KITCHEN=
NEXT_PUBLIC_DEPLOYER=
NEXT_PUBLIC_PONS_TOKEN_URL=

# AAPL (Robinhood stock token) — default is fine
NEXT_PUBLIC_AAPL_TOKEN=0xaF3D76f1834A1d425780943C99Ea8A608f8a93f9

# Race params (used before kitchen is live / as fallbacks)
NEXT_PUBLIC_DEADLINE_DAYS=30
NEXT_PUBLIC_CORE_TARGET_FRACTION=0.5

# ── Site narrative acts (bite-execution.md) ──────────────────────────
# Prologue = Pre-mint tease (no buy/trade CTAs → pons)
# Act I    = Finding the apple (preparing; burns locked; trading open)
# Act II   = First bite (kitchen live; early-eater 2×; meta wager locked)
# Act III  = To the core (auto when ≥5 eaters AND burn ≥10%, or force below)
#
# Default: Prologue when NEXT_PUBLIC_BITE_TOKEN is unset.
# Force act for QA / mint morning (omit to auto-resolve):
#   NEXT_PUBLIC_SITE_ACT=0  → Prologue
#   NEXT_PUBLIC_SITE_ACT=1  → Act I (Finding the apple)
#   NEXT_PUBLIC_SITE_ACT=2  → Act II
#   NEXT_PUBLIC_SITE_ACT=3  → Act III
# NEXT_PUBLIC_SITE_ACT=0
# NEXT_PUBLIC_SITE_ACT=1
# NEXT_PUBLIC_SITE_ACT=2
# NEXT_PUBLIC_SITE_ACT=3
#
# Optional Prologue toggles (SITE_ACT wins if set):
#   true  → force Prologue even if token is set
#   false → skip Prologue gate when token is missing (Act I for QA)
# NEXT_PUBLIC_PROLOGUE=true
# NEXT_PUBLIC_PROLOGUE=false
#
# ── Exit Prologue on mint morning ────────────────────────────────────
# 1. Set NEXT_PUBLIC_BITE_TOKEN=<CA> (and curve/pool/pons URL as needed)
# 2. Unset NEXT_PUBLIC_SITE_ACT=0 / NEXT_PUBLIC_PROLOGUE (or set SITE_ACT=1)
# 3. Keep NEXT_PUBLIC_DAY_ONE=true until kitchen is live (Act I feel)
# 4. Redeploy. Buy/Trade CTAs unlock; burns still wait for Act II.

# Unix timestamp when Act II started — drives 72h early-eater 2× banner.
# Set when you flip creator fees to the burn contract / announce Act II.
# NEXT_PUBLIC_ACT_II_STARTED_AT=1747000000

# Burn progress (0–1) at which meta wager unlocks (default 0.1 = 10%)
# NEXT_PUBLIC_META_WAGER_THRESHOLD=0.1

# Day-one / launch preview
# true  → auto (or playable) stop-motion 0→9; hide burn modal CTA (Act I feel)
# false → show burn modal when Act ≥ II (live race)
# Default: true when kitchen or token is missing; set explicitly for QA.
# Alias: NEXT_PUBLIC_DEMO_PLAYTHROUGH (same behavior)
NEXT_PUBLIC_DAY_ONE=true
# NEXT_PUBLIC_DEMO_PLAYTHROUGH=true

# Trade / Buy CTAs (day 1 = pons deep-link; no Uniswap in primary UX)
# pons (default) = open NEXT_PUBLIC_PONS_TOKEN_URL or launchpad fallback
# uniswap (opt-in) = SwapModal deep-link / optional iframe for later QA
# NEXT_PUBLIC_SWAP_PROVIDER=pons
# NEXT_PUBLIC_SWAP_PROVIDER=uniswap
# Iframe embed is OFF by default — Uniswap CSP blocks framing until origins are
# allowlisted via their help center. See docs/uniswap-embed-allowlist.md
# Request: http://localhost:3000, https://*.vercel.app, https://bite.party
# NEXT_PUBLIC_SWAP_EMBED_ENABLED=true
# Optional URL overrides (uniswap provider only):
# NEXT_PUBLIC_SWAP_EMBED_URL=https://app.uniswap.org/embed?view=swap&chain=ethereum&inputCurrency=ETH&outputCurrency=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# NEXT_PUBLIC_SWAP_OPEN_URL=https://app.uniswap.org/swap?chain=ethereum&inputCurrency=ETH&outputCurrency=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# Social / chart (optional — defaults to placeholders / PONS URL)
# NEXT_PUBLIC_TWITTER_URL=https://x.com/…
# NEXT_PUBLIC_TELEGRAM_URL=https://t.me/…
# NEXT_PUBLIC_CHART_URL=
