# Next public env — copy to .env.local and fill with YOUR values.
# Never commit .env.local or real secrets.

# ── Base Chain ──────────────────────────────────────────────────────
NEXT_PUBLIC_RPC_URL=https://mainnet.base.org

# WalletConnect Cloud project ID (https://cloud.walletconnect.com).
# Required for the WalletConnect connector; if unset, that connector is skipped.
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional Ethereum mainnet RPC for ENS reverse-resolution on the leaderboard.
# ENS_RPC_URL=https://1rpc.io/eth
# MAINNET_RPC_URL=

# ── $JUICE Token ────────────────────────────────────────────────────
# $JUICE token on Base. Leave blank for preview mode.
NEXT_PUBLIC_JUICE_TOKEN=
NEXT_PUBLIC_DEPLOYER=

# ── Juicebox V6 Revnet ─────────────────────────────────────────────
# Revnet project ID (Juicebox V6 on Base). Required for treasury interactions.
NEXT_PUBLIC_REVNET_PROJECT_ID=
# JBMultiTerminal address on Base — pay, addToBalanceOf, cashOut.
NEXT_PUBLIC_JB_MULTI_TERMINAL=
# JBController address on Base — token supply reads.
NEXT_PUBLIC_JB_CONTROLLER=
# REVDeployer address on Base — revnet stage config.
NEXT_PUBLIC_REV_DEPLOYER=

# ── NFT Containers ─────────────────────────────────────────────────
# ERC-721 container contract on Base — mint seed-tier NFTs.
NEXT_PUBLIC_JUICE_NFT_CONTRACT=

# ── Base Tokens (defaults if unset) ────────────────────────────────
# USDC on Base (6 decimals)
# NEXT_PUBLIC_USDC_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# WETH on Base
# NEXT_PUBLIC_WETH_TOKEN=0x4200000000000000000000000000000000000006

# ── Race / Press params ─────────────────────────────────────────────
NEXT_PUBLIC_DEADLINE_DAYS=30
NEXT_PUBLIC_CORE_TARGET_FRACTION=0.5

# ── Site narrative acts ──────────────────────────────────────────────
# Prologue = Pre-deploy tease (no buy/trade CTAs)
# Act I    = Loading the press (preparing; squeezes locked; trading open)
# Act II   = First squeeze (press live; early-squeezer 2×; meta wager locked)
# Act III  = To the last drop (auto when ≥5 squeezers AND squeeze ≥10%, or force below)
#
# Token CA is set → Act I auto-resolves when SITE_ACT is unset.
# Force act for QA only (omit in production):
#   NEXT_PUBLIC_SITE_ACT=0  → Prologue
#   NEXT_PUBLIC_SITE_ACT=1  → Act I
#   NEXT_PUBLIC_SITE_ACT=2  → Act II
#   NEXT_PUBLIC_SITE_ACT=3  → Act III
# NEXT_PUBLIC_SITE_ACT=1

# Unix timestamp when Act II started — drives 72h early-squeezer 2× banner.
# NEXT_PUBLIC_ACT_II_STARTED_AT=

# Squeeze progress (0–1) at which meta wager unlocks (default 0.1 = 10%)
# NEXT_PUBLIC_META_WAGER_THRESHOLD=0.1

# ReferralEscrow UUPS proxy — fund this address, not the impl. Set after deploy.
NEXT_PUBLIC_REFERRAL_ESCROW=

# Day-one / launch preview
# true  → auto stop-motion; hide squeeze modal CTA (Act I feel)
# false → show squeeze modal when Act ≥ II
# Default: true when revnet or token is missing.
NEXT_PUBLIC_DAY_ONE=true

# ── Swap / Trade CTAs ───────────────────────────────────────────────
# native (default) = SwapModal quotes via /api/uniswap/* on Base
# external = deep-link to Uniswap on Base
# NEXT_PUBLIC_SWAP_PROVIDER=external
# Server-only Uniswap Trading API key — never NEXT_PUBLIC_
# UNISWAP_API_KEY=
# Swap integrator fee: 50 bps (0.5%) to treasury.
# SWAP_OPS_RECIPIENT=
# NEXT_PUBLIC_SWAP_OPS_RECIPIENT=
# NEXT_PUBLIC_SWAP_EMBED_ENABLED=true
# Optional URL overrides:
# NEXT_PUBLIC_SWAP_OPEN_URL=

# ── Dexscreener ─────────────────────────────────────────────────────
# NEXT_PUBLIC_DEXSCREENER_PAIR_ID=

# ── Social / chart (optional) ───────────────────────────────────────
# NEXT_PUBLIC_TWITTER_URL=
# NEXT_PUBLIC_TELEGRAM_URL=
# NEXT_PUBLIC_CHART_URL=

# ── Meta Wager (optional) ───────────────────────────────────────────
# NEXT_PUBLIC_META_WAGER=

# ── Site URL ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://www.juiceparty.xyz

# ── Activity bot (Telegram) — prefer bots/.env ──────────────────────
# Never commit tokens.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# JUICE_CONTRACT=
# RPC_URL=https://mainnet.base.org
# PHASE=1
# DEV_WALLETS=
